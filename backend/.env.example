# Copy to .env. Defaults work out of the box with zero setup (SQLite + in-memory cache fallback).

APP_NAME=CommerceFlow
ENVIRONMENT=development

# SQLite by default. For production/docker-compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://commerceflow:commerceflow@db:5432/commerceflow
DATABASE_URL=sqlite+aiosqlite:///./commerceflow.db

# Redis is optional -- if unreachable, the app automatically falls back to an
# in-memory cache so it still runs.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

CORS_ORIGINS=["*"]
